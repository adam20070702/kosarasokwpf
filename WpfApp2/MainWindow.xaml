<Window x:Class="Kosarlabda.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kosárlabda Statisztikák" Height="780" Width="1250">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="tabla" Grid.Row="1" Margin="10,0,10,0" HeadersVisibility="Column"
                  HorizontalGridLinesBrush="Black" LoadingRow="tabla_LoadingRow"/>
    </Grid>
</Window>